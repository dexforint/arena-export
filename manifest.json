{
	"manifest_version": 3,
	"name": "Arena.ai Dialog Export",
	"version": "0.6.1",
	"description": "Exports arena.ai conversation messages to Markdown files.",
	"permissions": ["activeTab", "downloads"],
	"host_permissions": ["https://arena.ai/*", "https://*.arena.ai/*"],
	"background": {
		"service_worker": "background.js"
	},
	"action": {
		"default_title": "Export arena.ai dialog"
	},
	"content_scripts": [
		{
			"matches": ["https://arena.ai/*", "https://*.arena.ai/*"],
			"js": ["pageBridge.js"],
			"run_at": "document_start",
			"world": "MAIN"
		},
		{
			"matches": ["https://arena.ai/*", "https://*.arena.ai/*"],
			"js": ["content.js"],
			"run_at": "document_idle"
		}
	],
	"icons": {
		"16": "icons/16.png",
		"48": "icons/48.png",
		"128": "icons/128.png"
	}
}
