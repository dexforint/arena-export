{
	"manifest_version": 3,
	"name": "Arena.ai Dialog Export",
	"version": "0.3.0",
	"description": "Экспортирует сообщения диалога arena.ai в Markdown файлы.",
	"permissions": ["activeTab", "downloads"],
	"host_permissions": ["https://arena.ai/*", "https://*.arena.ai/*"],
	"background": {
		"service_worker": "background.js"
	},
	"action": {
		"default_title": "Export arena.ai dialog"
	},
	"content_scripts": [
		{
			"matches": ["https://arena.ai/*", "https://*.arena.ai/*"],
			"js": ["vendor/turndown.js", "vendor/turndown-plugin-gfm.js", "content.js"],
			"run_at": "document_idle"
		}
	]
}
